#!/usr/bin/env bash
# ════════════════════════════════════════════════════════════════════
#  my-computer — what this machine is, and how it is doing right now.
#
#  A neofetch-style report that depends on NO system-info package.
#  Facts come from the operating system's own interfaces:
#
#    Linux   /etc/os-release · /proc/{cpuinfo,meminfo,uptime,loadavg}
#            /proc/{mounts,net/route,net/fib_trie,net/wireless}
#            /sys/class/{net,drm,power_supply,thermal,hwmon,bluetooth}
#            /sys/class/rfkill · /sys/block · /sys/bus/usb
#            /sys/devices/virtual/dmi/id · /var/lib/dpkg/info/*.list
#    macOS   sw_vers · sysctl · vm_stat · pmset      (all part of macOS)
#    BSD     sysctl · /etc/os-release where present
#
#  ── Responsive layout ─────────────────────────────────────────────
#  The report is a set of panels laid out in as many columns as the
#  terminal can actually hold, recomputed on every run — so widening
#  the window or zooming out reflows it instead of leaving empty space,
#  and narrowing it degrades to a single column instead of wrapping.
#
#    < 74 cols     1 column
#    74–113        2 columns
#    ≥ 114         3 columns
#
#  Panel order is by importance, because in a narrow terminal the last
#  ones are the ones scrolled off: ATTENTION, SYSTEM, HARDWARE, MEMORY,
#  STORAGE, NETWORK, DEVICES, STATUS. ATTENTION and STATUS span the
#  full width; the rest flow into the grid.
#
#  ── Portability ───────────────────────────────────────────────────
#    • Linux, macOS and the BSDs have their own collectors; anything a
#      platform will not report shows as "—" rather than failing.
#    • No bash 4 features, so the system bash on macOS (3.2) is fine.
#    • Non-UTF-8 terminals get an ASCII frame and meters automatically
#      (forced with --ascii), so nothing becomes mojibake on a serial
#      console or in a minimal container.
#    • Colour drops when piped, under $NO_COLOR, or with --no-color.
#
#  ── External commands, and why each is safe to rely on ────────────
#  Arithmetic, string handling and padding use shell builtins only.
#  The externals are base-system tools, never third-party packages:
#
#    uname            everywhere    platform and architecture
#    df               everywhere    filesystem usage — needs statfs(2),
#                                   which a shell cannot call itself
#    sort             everywhere    de-duplicating GPUs and addresses
#    awk              everywhere    one indexed scan of pci.ids (~25k
#                                   lines); a bash read loop takes ~0.5s
#    sysctl vm_stat   macOS/BSD     CPU, memory, uptime
#    sw_vers pmset    macOS         product version, battery
#
#  Optional, used only if already present, never required:
#    iw / nmcli       the Wi-Fi SSID. Signal strength comes from
#                     /proc/net/wireless and needs neither.
#
#  Usage:
#    my-computer [--all] [--columns N] [--width N]
#                [--ascii] [--no-color] [--no-banner] [--banner TEXT]
#
#      --all        verbose: virtual interfaces, idle swap, locale,
#                   reclaimable cache, every USB device
#      --columns N  force the column count instead of measuring
# ════════════════════════════════════════════════════════════════════
set -uo pipefail
shopt -s extglob 2>/dev/null || true

have() { command -v "$1" >/dev/null 2>&1; }
OS="$(uname -s 2>/dev/null || printf 'Unknown')"

# ── Options ────────────────────────────────────────────────────────
use_color=1; show_all=0; width_opt=0; force_ascii=0
show_banner=1; banner_override=''; col_opt=0

[[ -t 1 ]] || use_color=0
[[ -n "${NO_COLOR:-}" ]] && use_color=0

while (( $# )); do
  case "$1" in
    --no-color)  use_color=0 ;;
    --ascii)     force_ascii=1 ;;
    --all)       show_all=1 ;;
    --no-banner) show_banner=0 ;;
    --banner)    shift; banner_override="${1:-}" ;;
    --width)     shift; width_opt="${1:-0}" ;;
    --columns)   shift; col_opt="${1:-0}" ;;
    -h|--help)
      while IFS= read -r l; do
        [[ "$l" == '#'* ]] || break
        printf '%s\n' "${l/\# /}"
      done < <(tail -n +2 "$0")
      exit 0 ;;
    *) printf 'my-computer: unknown option %s\n' "$1" >&2; exit 2 ;;
  esac
  shift
done

# ── Capabilities ───────────────────────────────────────────────────
unicode=1
(( force_ascii )) && unicode=0
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
  *UTF-8*|*utf-8*|*UTF8*|*utf8*) ;;
  *) unicode=0 ;;
esac

if (( unicode )); then
  G_TL='╭' G_TR='╮' G_BL='╰' G_BR='╯' G_H='─' G_V='│'
  G_FULL='█' G_EMPTY='░' G_UP='▲' G_SEP='·' G_DEG='°C' G_DASH='—' G_DOT='●'
  G_ML='├' G_MR='┤'
else
  # G_SEP is deliberately not '|': the frame uses that glyph, and an
  # inline '|' inside a panel reads as a broken border.
  G_TL='+' G_TR='+' G_BL='+' G_BR='+' G_H='-' G_V='|'
  G_FULL='#' G_EMPTY='.' G_UP='!' G_SEP='-' G_DEG='C' G_DASH='-' G_DOT='*'
  G_ML='+' G_MR='+'
fi

# One accent, plus dim, plus three status colours. A second decorative
# hue competes with the accent and the eye stops knowing where to look.
if (( use_color )); then
  R=$'\033[0m'; B=$'\033[1m'; D=$'\033[2m'
  RED=$'\033[31m'; GRN=$'\033[32m'; YEL=$'\033[33m'; ACC=$'\033[36m'
else
  R='' B='' D='' RED='' GRN='' YEL='' ACC=''
fi

# ── Responsive layout ──────────────────────────────────────────────
# Finding the real terminal width is the whole basis of the layout, and
# $COLUMNS alone does NOT provide it. Interactive shells maintain
# COLUMNS as a shell variable but do not EXPORT it, so a child process
# like this one sees nothing — which silently pinned the report to the
# fallback width and one column no matter how wide the window was.
#
# Sources, in order of trustworthiness:
#   1. $COLUMNS      only meaningful if the caller deliberately exported it
#   2. stty size     asks the controlling terminal directly, and keeps
#                    working when stdout is redirected, because it reads
#                    /dev/tty rather than fd 1
#   3. tput cols     ncurses' answer; falls back to $TERM's terminfo
#   4. 80            the historical default, and a safe last resort
term_cols() {
  local c=''
  [[ -n "${COLUMNS:-}" && "$COLUMNS" != *[!0-9]* ]] && (( COLUMNS > 0 )) && c="$COLUMNS"
  if [[ -z "$c" ]] && have stty && [[ -r /dev/tty ]]; then
    local _rows _cols
    read -r _rows _cols < <(stty size </dev/tty 2>/dev/null)
    [[ -n "${_cols:-}" && "$_cols" != *[!0-9]* ]] && c="$_cols"
  fi
  if [[ -z "$c" ]] && have tput; then
    local t; t="$(tput cols 2>/dev/null)"
    [[ -n "$t" && "$t" != *[!0-9]* ]] && c="$t"
  fi
  [[ -z "$c" || "$c" == *[!0-9]* ]] && c=80
  printf '%d' "$c"
}

if (( width_opt > 0 )); then
  W=$width_opt
else
  W=$(( $(term_cols) - 4 ))     # 2-column indent on each side
  (( W < 40 )) && W=40
fi

GAP=2
MINBOX=34                        # below this a panel stops being readable:
                                 # the label and value columns collide
MAXCOL=4                         # past four, the eye has to travel too far
                                 # back to the left to start the next row
if (( col_opt > 0 )); then
  NCOL=$col_opt
else
  NCOL=1
  while (( NCOL < MAXCOL )); do
    if (( (W - NCOL * GAP) / (NCOL + 1) >= MINBOX )); then
      NCOL=$(( NCOL + 1 ))
    else
      break
    fi
  done
fi
BOXW=$(( (W - (NCOL - 1) * GAP) / NCOL ))
(( BOXW > 60 )) && (( NCOL == 1 )) && BOXW=60   # one wide column still reads
                                                # badly past ~60 columns
FULLW=$(( BOXW * NCOL + (NCOL - 1) * GAP ))
LW=10                             # label column inside a panel
(( BOXW >= 44 )) && LW=12

# ── Builtin-only helpers ───────────────────────────────────────────
rep()   { local c=$1 n=$2 s=''; while (( n-- > 0 )); do s+="$c"; done; printf '%s' "$s"; }
slurp() { local l; [[ -r "$1" ]] && IFS= read -r l < "$1" 2>/dev/null && printf '%s' "$l"; }
cmd1()  { local o; o="$("$@" 2>/dev/null)" || return; printf '%s' "${o%%$'\n'*}"; }
sysctl_n() { have sysctl && cmd1 sysctl -n "$1"; }
rtrim() { local s=$1; printf '%s' "${s%"${s##*[![:space:]]}"}"; }

# /proc/mounts escapes characters that would break its own field
# splitting, as octal: a space becomes \040, a tab \011. Printed raw,
# a USB stick labelled "UBUNTU 26_0" shows up as "UBUNTU\04026_0".
unescape_mount() {
  local s=$1
  s="${s//\\040/ }"; s="${s//\\011/	}"
  s="${s//\\012/ }"; s="${s//\\134/\\}"
  printf '%s' "$s"
}

# Visible length: colour codes occupy no columns, so every width
# calculation has to measure the text with them removed.
strip_ansi() { local s=$1; printf '%s' "${s//$'\033'\[*([0-9;])m/}"; }
vlen() { local s; s="$(strip_ansi "$1")"; printf '%d' "${#s}"; }

# Truncate to a visible width. Colour is dropped when the text actually
# has to be cut — keeping it would mean splitting an escape sequence.
vfit() {
  local s=$1 want=$2 plain
  plain="$(strip_ansi "$s")"
  if (( ${#plain} <= want )); then printf '%s' "$s"; return; fi
  (( want <= 1 )) && { printf '%s' "${plain:0:want}"; return; }
  printf '%s%s' "${plain:0:$(( want - 1 ))}" "${unicode:+…}"
}

hkib() {
  local k=$1
  if   (( k >= 1048576 )); then printf '%d.%d GiB' $(( k / 1048576 )) $(( (k % 1048576) * 10 / 1048576 ))
  elif (( k >= 1024    )); then printf '%d MiB'    $(( k / 1024 ))
  else                          printf '%d KiB'    "$k"
  fi
}

hpair() {
  local u=$1 t=$2
  if (( t >= 1048576 )); then
    printf '%d.%d / %d.%d GiB' $(( u / 1048576 )) $(( (u % 1048576) * 10 / 1048576 )) \
                               $(( t / 1048576 )) $(( (t % 1048576) * 10 / 1048576 ))
  elif (( t >= 1024 )); then
    printf '%d / %d MiB' $(( u / 1024 )) $(( t / 1024 ))
  else
    printf '%d / %d KiB' "$u" "$t"
  fi
}

hsecs() {
  local s=${1%%.*} o=''
  (( s >= 86400 )) && { o+="$(( s / 86400 ))d "; s=$(( s % 86400 )); }
  (( s >= 3600  )) && { o+="$(( s / 3600  ))h "; s=$(( s % 3600  )); }
  o+="$(( s / 60 ))m"
  printf '%s' "$o"
}

sev() {
  local p=$1
  if   (( p >= 90 )); then printf '%s' "$RED"
  elif (( p >= 75 )); then printf '%s' "$YEL"
  else                     printf '%s' "$GRN"
  fi
}

# ════════════════════════════════════════════════════════════════════
#  Panels
#
#  A panel is built row by row, then rendered to a fixed width and
#  stashed. Rendering has to finish before anything prints, because
#  panels sit SIDE BY SIDE: line 3 of the left panel and line 3 of the
#  right one are emitted together.
# ════════════════════════════════════════════════════════════════════
PANELS=()        # rendered text, newline-joined
PANEL_FULL=()    # 1 = spans every column

_ptitle=''; _prows=(); _pw=0; _pfull=0

panel_begin() { _ptitle="$1"; _pfull="${2:-0}"; _prows=(); }

# Rows carry a unit separator between label and value so a value may
# contain anything, spaces included.
panel_row()  { _prows+=( "$1"$'\x1f'"$2" ); }
panel_rule() { _prows+=( $'\x1e' ); }
# Full-bleed text: no label column, so it may use the panel's whole
# inner width. Continuation lines under a labelled row use panel_row
# with an empty label instead, which keeps the indent.
panel_text() { _prows+=( $'\x1d'"$1" ); }

# A meter sized to the panel: bar, then the percentage. Detail goes on
# a continuation line when the panel is too narrow to carry it inline,
# which keeps the bars aligned in a column instead of ragged.
panel_meter() {
  local label=$1 pct=$2 detail=$3
  (( pct < 0 )) && pct=0; (( pct > 100 )) && pct=100
  local avail=$(( _pw - 4 - LW - 1 ))     # inside borders, after label
  local barw=$(( avail - 5 ))             # room for " 100%"
  (( barw > 16 )) && barw=16
  (( barw < 6 ))  && barw=6
  local filled=$(( pct * barw / 100 ))
  (( filled == 0 && pct > 0 )) && filled=1
  (( filled == barw && pct < 100 )) && filled=$(( barw - 1 ))
  local bar
  bar="$(sev "$pct")$(rep "$G_FULL" $filled)$R$D$(rep "$G_EMPTY" $(( barw - filled )))$R"
  local head
  head="$bar $(sev "$pct")$(printf '%3d%%' "$pct")$R"
  if (( avail - barw - 5 >= ${#detail} + 2 )); then
    panel_row "$label" "$head  ${D}${detail}${R}"
  else
    panel_row "$label" "$head"
    [[ -n "$detail" ]] && panel_row "" "${D}${detail}${R}"
  fi
}

panel_end() {
  local w=$_pw inner=$(( _pw - 2 )) out='' t=" $_ptitle " fill row label value line
  fill=$(( inner - 1 - ${#t} ))
  (( fill < 0 )) && fill=0
  out="${ACC}${G_TL}${G_H}${B}${t}${R}${ACC}$(rep "$G_H" $fill)${G_TR}${R}"

  for row in "${_prows[@]}"; do
    if [[ "$row" == $'\x1e' ]]; then
      out+=$'\n'"${ACC}${G_ML}${D}$(rep "$G_H" $inner)${R}${ACC}${G_MR}${R}"
      continue
    fi
    if [[ "$row" == $'\x1d'* ]]; then
      value="$(vfit "${row#$'\x1d'}" $(( inner - 4 )))"
      line="  ${value}"
      out+=$'\n'"${ACC}${G_V}${R}${line}$(rep ' ' $(( inner - $(vlen "$line") )))${ACC}${G_V}${R}"
      continue
    fi
    label="${row%%$'\x1f'*}"; value="${row#*$'\x1f'}"
    if [[ -n "$label" ]]; then
      value="$(vfit "$value" $(( inner - 3 - LW )))"
      line="  ${D}$(printf '%-*s' "$LW" "$label")${R} ${value}"
    else
      # Continuation / free text: indent past the label column so it
      # reads as belonging to the row above.
      value="$(vfit "$value" $(( inner - 3 - LW )))"
      line="  $(rep ' ' $LW) ${value}"
    fi
    out+=$'\n'"${ACC}${G_V}${R}${line}$(rep ' ' $(( inner - $(vlen "$line") )))${ACC}${G_V}${R}"
  done

  out+=$'\n'"${ACC}${G_BL}$(rep "$G_H" $inner)${G_BR}${R}"
  PANELS+=( "$out" )
  PANEL_FULL+=( "$_pfull" )
}

# ── Collectors ─────────────────────────────────────────────────────
os_name='' kernel='' uptime_s='' pkgs='' machine='' bios='' chassis='' brand=''
cpu_model='' cores=0 threads=0 clock_mhz=0 clock_max_mhz=0
mem_total=0 mem_used=0 mem_cached=0 swap_total=0 swap_used=0
load_txt='' proc_count='' temp_c='' bat_pct='' bat_state='' bat_health=''
wifi_if='' wifi_qual='' wifi_dbm='' wifi_ssid=''
bt_present=0 bt_blocked=0 bt_conns=0
gateway='' dns_txt='' primary_ip='' default_iface=''
disk_pct=(); disks=(); removables=(); usb_names=(); nets=()

chassis_name() {
  case "$1" in
    3) printf 'Desktop';;      4) printf 'Low Profile';;  5) printf 'Pizza Box';;
    6) printf 'Mini Tower';;   7) printf 'Tower';;        8) printf 'Portable';;
    9) printf 'Laptop';;      10) printf 'Notebook';;    11) printf 'Hand Held';;
   13) printf 'All In One';;  14) printf 'Sub Notebook';;
   17) printf 'Server';;      23) printf 'Rack Mount';;
   30) printf 'Tablet';;      31) printf 'Convertible';; 32) printf 'Detachable';;
    *) printf '';;
  esac
}

collect_linux() {
  if [[ -r /etc/os-release ]]; then
    while IFS='=' read -r k v; do
      v="${v%\"}"; v="${v#\"}"
      case "$k" in PRETTY_NAME) os_name="$v";; ID) brand="$v";; esac
    done < /etc/os-release
  fi
  kernel="$(slurp /proc/sys/kernel/osrelease)"
  read -r uptime_s _ < /proc/uptime 2>/dev/null || uptime_s=''

  if [[ -d /var/lib/dpkg/info ]]; then
    # One .list per installed package — a glob, rather than parsing the
    # status file, which also lists packages removed but not purged.
    shopt -s nullglob; local l=( /var/lib/dpkg/info/*.list ); shopt -u nullglob
    (( ${#l[@]} )) && pkgs="${#l[@]} dpkg"
  fi

  local dmi=/sys/devices/virtual/dmi/id vendor product bv bd
  vendor="$(slurp $dmi/sys_vendor)"; product="$(slurp $dmi/product_name)"
  machine="$product"
  [[ -n "$vendor" && "$product" != "$vendor"* ]] && machine="$vendor $product"
  bv="$(slurp $dmi/bios_version)"; bd="$(slurp $dmi/bios_date)"
  [[ -n "$bv" ]] && bios="$bv${bd:+ ${G_SEP} $bd}"
  chassis="$(chassis_name "$(slurp $dmi/chassis_type)")"

  # Physical cores are the distinct (physical id, core id) pairs — what
  # separates real cores from hyperthreads, which /proc/cpuinfo lists
  # identically. Tracked in a string, not an associative array, so this
  # still runs under the bash 3.2 that macOS ships.
  local seen=' ' phys='' core='' line
  while IFS= read -r line; do
    case "$line" in
      "model name"*)  [[ -z "$cpu_model" ]] && cpu_model="${line#*: }" ;;
      processor*)     threads=$(( threads + 1 )) ;;
      "physical id"*) phys="${line#*: }" ;;
      "core id"*)     core="${line#*: }"
                      [[ "$seen" == *" $phys/$core "* ]] || { seen+="$phys/$core "; cores=$(( cores + 1 )); } ;;
    esac
  done < /proc/cpuinfo 2>/dev/null

  local sum=0 n=0 f k
  for f in /sys/devices/system/cpu/cpu[0-9]*/cpufreq/scaling_cur_freq; do
    [[ -r "$f" ]] || continue
    k="$(slurp "$f")"; [[ -z "$k" || "$k" == *[!0-9]* ]] && continue
    sum=$(( sum + k )); n=$(( n + 1 ))
  done
  (( n )) && clock_mhz=$(( sum / n / 1000 ))
  k="$(slurp /sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq)"
  [[ -n "$k" && "$k" != *[!0-9]* ]] && clock_max_mhz=$(( k / 1000 ))

  local key v cached=0 buffers=0
  while read -r key v _; do
    case "$key" in
      MemTotal:)     mem_total=$v ;;
      # Used = total - available, NOT total - free: "free" excludes the
      # cache the kernel returns on demand, which makes an ordinary
      # system look nearly out of memory.
      MemAvailable:) mem_used=$v ;;
      Cached:)       cached=$v ;;
      Buffers:)      buffers=$v ;;
      SwapTotal:)    swap_total=$v ;;
      SwapFree:)     swap_used=$v ;;
    esac
  done < /proc/meminfo 2>/dev/null
  mem_used=$(( mem_total - mem_used )); swap_used=$(( swap_total - swap_used ))
  mem_cached=$(( cached + buffers ))

  if [[ -r /proc/loadavg ]]; then
    local a b c p
    read -r a b c p _ < /proc/loadavg
    load_txt="$a $b $c"; proc_count="${p#*/}"
  fi

  local h t z
  for h in /sys/class/hwmon/hwmon*; do
    case "$(slurp "$h/name")" in
      coretemp|k10temp|zenpower|cpu_thermal)
        t="$(slurp "$h/temp1_input")"
        [[ -n "$t" && "$t" != *[!0-9]* ]] && { temp_c=$(( t / 1000 )); break; } ;;
    esac
  done
  if [[ -z "$temp_c" ]]; then
    for z in /sys/class/thermal/thermal_zone*; do
      case "$(slurp "$z/type")" in
        x86_pkg_temp|acpitz|cpu*)
          t="$(slurp "$z/temp")"
          [[ -n "$t" && "$t" != *[!0-9]* ]] && (( t > 0 )) && { temp_c=$(( t / 1000 )); break; } ;;
      esac
    done
  fi

  local bat a full design
  for bat in /sys/class/power_supply/BAT*; do
    [[ -d "$bat" ]] || continue
    bat_pct="$(slurp "$bat/capacity")"
    [[ -z "$bat_pct" || "$bat_pct" == *[!0-9]* ]] && { bat_pct=''; continue; }
    bat_state="$(slurp "$bat/status")"
    # Wear: what the cell holds now against what it shipped with. This
    # is the number that explains a laptop that stopped lasting.
    full="$(slurp "$bat/energy_full")"; design="$(slurp "$bat/energy_full_design")"
    [[ -z "$full"   ]] && full="$(slurp "$bat/charge_full")"
    [[ -z "$design" ]] && design="$(slurp "$bat/charge_full_design")"
    if [[ -n "$full" && -n "$design" && "$full" != *[!0-9]* && "$design" != *[!0-9]* ]] \
       && (( design > 0 )); then bat_health=$(( full * 100 / design )); fi
    for a in /sys/class/power_supply/A{C,DP}*; do
      [[ -r "$a/online" ]] || continue
      [[ "$(slurp "$a/online")" == 1 ]] && bat_state+=" ${G_SEP} AC" || bat_state+=" ${G_SEP} battery"
      break
    done
    break
  done

  collect_linux_net
  collect_linux_disks
}

collect_linux_net() {
  local iface dest line name
  if [[ -r /proc/net/route ]]; then
    while read -r iface dest gw _; do
      if [[ "$dest" == "00000000" ]]; then
        default_iface="$iface"
        # Gateway is little-endian hex, same encoding as the routes.
        [[ "$gw" != "00000000" && ${#gw} == 8 ]] && \
          gateway="$(( 0x${gw:6:2} )).$(( 0x${gw:4:2} )).$(( 0x${gw:2:2} )).$(( 0x${gw:0:2} ))"
        break
      fi
    done < <(tail -n +2 /proc/net/route 2>/dev/null)
  fi

  # Locally-assigned IPv4s: in /proc/net/fib_trie an address sits on the
  # line before its "/32 host LOCAL" marker.
  local -a ips=(); local prev='' cand
  if [[ -r /proc/net/fib_trie ]]; then
    while IFS= read -r line; do
      if [[ "$line" == *"/32 host"* ]]; then
        cand="${prev##*|-- }"; cand="${cand// /}"
        [[ -n "$cand" && "$cand" != 127.* && "$cand" != 0.0.0.0 ]] && ips+=( "$cand" )
      fi
      prev="$line"
    done < /proc/net/fib_trie
  fi
  # Keep the address inside the default route's subnet. The first
  # address found is the wrong answer on any machine running containers,
  # where a docker or lxc bridge owns one too.
  local rif rdest rmask net msk ip
  if [[ -n "$default_iface" && ${#ips[@]} -gt 0 ]]; then
    while read -r rif rdest _ _ _ _ _ rmask _; do
      [[ "$rif" == "$default_iface" && "$rdest" != "00000000" ]] || continue
      net=$(( 0x${rdest:6:2} << 24 | 0x${rdest:4:2} << 16 | 0x${rdest:2:2} << 8 | 0x${rdest:0:2} ))
      msk=$(( 0x${rmask:6:2} << 24 | 0x${rmask:4:2} << 16 | 0x${rmask:2:2} << 8 | 0x${rmask:0:2} ))
      for ip in "${ips[@]}"; do
        [[ "$ip" == *[!0-9.]* ]] && continue
        local o1 o2 o3 o4; IFS=. read -r o1 o2 o3 o4 <<< "$ip"
        (( ((o1 << 24 | o2 << 16 | o3 << 8 | o4) & msk) == net )) && { primary_ip="$ip"; break 2; }
      done
    done < <(tail -n +2 /proc/net/route 2>/dev/null)
  fi
  [[ -z "$primary_ip" && ${#ips[@]} -gt 0 ]] && primary_ip="${ips[0]}"

  local -a ns=()
  while read -r k v _; do [[ "$k" == nameserver ]] && ns+=( "$v" ); done < /etc/resolv.conf 2>/dev/null
  (( ${#ns[@]} )) && dns_txt="${ns[0]}"
  (( ${#ns[@]} > 1 )) && dns_txt+=" +$(( ${#ns[@]} - 1 ))"

  # Wi-Fi quality and signal come straight from /proc/net/wireless, so
  # no wireless tooling is needed for the part that changes minute to
  # minute. Only the SSID needs a helper, and it stays optional.
  # /proc/net/wireless columns are:
  #   iface:  status  link  level  noise  ...
  # The status field sits between the name and the link quality; reading
  # it as the quality is why this reported 0% while the link was fine.
  # Values carry a trailing '.' that has to come off before arithmetic.
  if [[ -r /proc/net/wireless ]]; then
    local wname wstat wlink wlevel
    while read -r wname wstat wlink wlevel _; do
      [[ "$wname" == *: ]] || continue
      wifi_if="${wname%:}"
      wlink="${wlink%.}"; wlevel="${wlevel%.}"
      # Link quality is reported against a 70-point scale.
      [[ -n "$wlink"  && "$wlink"  != *[!0-9]*  ]] && wifi_qual=$(( wlink * 100 / 70 ))
      [[ -n "$wlevel" && "$wlevel" != *[!0-9-]* ]] && wifi_dbm="$wlevel"
      break
    done < <(tail -n +3 /proc/net/wireless 2>/dev/null)
  fi
  if [[ -n "$wifi_if" ]]; then
    if have iw;    then wifi_ssid="$(iw dev "$wifi_if" link 2>/dev/null | sed -n 's/.*SSID: //p' | head -1)"; fi
    if [[ -z "$wifi_ssid" ]] && have nmcli; then
      wifi_ssid="$(nmcli -t -f active,ssid dev wifi 2>/dev/null | sed -n 's/^yes://p' | head -1)"
    fi
  fi

  # Bluetooth: the adapter is a directory, each live connection is a
  # child of it, and rfkill says whether the radio is actually enabled.
  local hci rk
  for hci in /sys/class/bluetooth/hci[0-9]*; do
    [[ -e "$hci" ]] || continue
    case "${hci##*/}" in *:*) continue ;; esac
    bt_present=1
    break
  done
  if (( bt_present )); then
    for hci in /sys/class/bluetooth/hci[0-9]*:*; do
      [[ -e "$hci" ]] && bt_conns=$(( bt_conns + 1 ))
    done
    for rk in /sys/class/rfkill/rfkill*; do
      [[ "$(slurp "$rk/type")" == bluetooth ]] || continue
      [[ "$(slurp "$rk/soft")" == 1 || "$(slurp "$rk/hard")" == 1 ]] && bt_blocked=1
      break
    done
  fi

  local ifp nm
  for ifp in /sys/class/net/*; do
    nm="${ifp##*/}"
    [[ "$nm" == lo ]] && continue
    [[ "$(slurp "$ifp/operstate")" == up ]] || continue
    nets+=( "$nm" )
  done
}

collect_linux_disks() {
  local b n rem size model vendor kind
  for b in /sys/block/*; do
    n="${b##*/}"
    # loop devices are snap mounts, ram/zram are memory — neither is a
    # disk anyone means when they ask what is plugged in.
    case "$n" in loop*|ram*|zram*|dm-*|sr*) continue ;; esac
    size="$(slurp "$b/size")"
    [[ -z "$size" || "$size" == *[!0-9]* ]] && continue
    (( size == 0 )) && continue
    rem="$(slurp "$b/removable")"
    model="$(slurp "$b/device/model")"
    vendor="$(slurp "$b/device/vendor")"
    # Trim the fixed-width padding the kernel keeps in these fields.
    model="$(rtrim "${model## }")"; vendor="$(rtrim "${vendor## }")"
    [[ -n "$vendor" && "$model" != "$vendor"* ]] && model="$vendor $model"
    [[ -z "$model" ]] && model="$n"
    if [[ "$(slurp "$b/queue/rotational")" == 1 ]]; then kind='HDD'; else kind='SSD'; fi
    # size is in 512-byte sectors, so /2 gives KiB.
    if [[ "$rem" == 1 ]]; then
      removables+=( "$n"$'\x1f'"$model"$'\x1f'"$(( size / 2 ))" )
    else
      disks+=( "$n"$'\x1f'"$model ${G_SEP} $kind"$'\x1f'"$(( size / 2 ))" )
    fi
  done

  local u p
  for u in /sys/bus/usb/devices/*; do
    p="$u/product"
    [[ -r "$p" ]] || continue
    n="$(slurp "$p")"
    # Root hubs are the machine's own controllers, not anything plugged
    # in, and listing them buries what is.
    case "$n" in *"Host Controller"*|*"root hub"*) continue ;; esac
    usb_names+=( "$(rtrim "${n## }")" )
  done
}

collect_darwin() {
  local prod ver build bt now
  prod="$(cmd1 sw_vers -productName)"; ver="$(cmd1 sw_vers -productVersion)"
  build="$(cmd1 sw_vers -buildVersion)"
  os_name="${prod:-macOS}${ver:+ $ver}${build:+ ($build)}"
  brand="${prod:-macos}"
  kernel="$(cmd1 uname -r)"
  bt="$(sysctl_n kern.boottime)"; bt="${bt#*sec = }"; bt="${bt%%,*}"
  now="$(cmd1 date +%s)"
  [[ -n "$bt" && -n "$now" && "$bt" != *[!0-9]* ]] && uptime_s=$(( now - bt ))
  machine="$(sysctl_n hw.model)"
  cpu_model="$(sysctl_n machdep.cpu.brand_string)"
  cores="$(sysctl_n hw.physicalcpu)"; cores="${cores:-0}"
  threads="$(sysctl_n hw.logicalcpu)"; threads="${threads:-0}"
  local hz bytes; hz="$(sysctl_n hw.cpufrequency)"
  [[ -n "$hz" && "$hz" != *[!0-9]* ]] && clock_mhz=$(( hz / 1000000 ))
  bytes="$(sysctl_n hw.memsize)"
  [[ -n "$bytes" && "$bytes" != *[!0-9]* ]] && mem_total=$(( bytes / 1024 ))
  if have vm_stat; then
    local psize active=0 wired=0 comp=0 line n
    psize="$(sysctl_n hw.pagesize)"; psize="${psize:-4096}"
    while IFS= read -r line; do
      n="${line##*:}"; n="${n//[^0-9]/}"
      case "$line" in
        "Pages active"*)                 active="${n:-0}" ;;
        "Pages wired down"*)             wired="${n:-0}" ;;
        "Pages occupied by compressor"*) comp="${n:-0}" ;;
      esac
    done < <(vm_stat 2>/dev/null)
    mem_used=$(( (active + wired + comp) * psize / 1024 ))
  fi
  local la; la="$(sysctl_n vm.loadavg)"; la="${la//[{}]/}"
  [[ -n "$la" ]] && load_txt="$(rtrim "${la## }")"
  proc_count="$(sysctl_n kern.proc_count)"
  if have pmset; then
    local pl p
    pl="$(pmset -g batt 2>/dev/null | tr '\n' ' ')"
    if [[ "$pl" == *%* ]]; then
      p="${pl%%\%*}"; p="${p##* }"
      [[ -n "$p" && "$p" != *[!0-9]* ]] && bat_pct="$p"
      case "$pl" in *"AC Power"*) bat_state="AC" ;; *"Battery Power"*) bat_state="battery" ;; esac
    fi
  fi
}

collect_bsd() {
  os_name="$(cmd1 uname -sr)"; kernel="$(cmd1 uname -r)"
  brand="$(cmd1 uname -s)"
  machine="$(sysctl_n hw.model)"; cpu_model="$machine"
  threads="$(sysctl_n hw.ncpu)"; threads="${threads:-0}"; cores=$threads
  local bytes; bytes="$(sysctl_n hw.physmem)"
  [[ -n "$bytes" && "$bytes" != *[!0-9]* ]] && mem_total=$(( bytes / 1024 ))
  local la; la="$(sysctl_n vm.loadavg)"; la="${la//[{}]/}"
  [[ -n "$la" ]] && load_txt="$(rtrim "${la## }")"
}

case "$OS" in
  Linux)  collect_linux ;;
  Darwin) collect_darwin ;;
  *)      collect_bsd ;;
esac

# ── Banner and identity ────────────────────────────────────────────
host="$(slurp /proc/sys/kernel/hostname)"
[[ -z "$host" ]] && host="$(cmd1 uname -n)"
[[ -z "$host" ]] && host="${HOSTNAME:-unknown}"
user="${USER:-${LOGNAME:-$(id -un 2>/dev/null)}}"
arch="$(cmd1 uname -m)"

printf '\n'
if (( show_banner )) && have asciify; then
  banner_text="${banner_override:-$brand}"
  if [[ -n "$banner_text" ]]; then
    bargs=( --trim --width "$FULLW" )
    (( unicode )) || bargs+=( --char '#' )
    # A fresh random hue per letter each run. asciify itself refuses to
    # emit colour when stdout is not a terminal, so a captured banner
    # stays plain — and stays measurable, since escape codes would
    # otherwise be counted as width.
    if (( use_color )); then
      bargs+=( --rainbow )
      banner_colour=''          # asciify already coloured every letter
    else
      banner_colour="$ACC"
    fi
    if bout="$(asciify "${bargs[@]}" "$banner_text" 2>/dev/null)" && [[ -n "$bout" ]]; then
      while IFS= read -r bl; do
        printf '  %s%s%s\n' "$banner_colour" "$bl" "${banner_colour:+$R}"
      done <<< "$bout"
      printf '\n'
    fi
  fi
fi
# Assemble from whole fields and drop them from the least important end
# until it fits, rather than slicing mid-word. "Ubuntu 26.04 LTS · x8…"
# tells the reader less than simply omitting the architecture would.
idparts=( "${os_name:-$OS}" )
[[ -n "$arch"     ]] && idparts+=( "$arch" )
[[ -n "$uptime_s" ]] && idparts+=( "up $(hsecs "$uptime_s")" )
idn=${#idparts[@]}
while (( idn > 0 )); do
  idtail=''
  for (( ii = 0; ii < idn; ii++ )); do idtail+="${idtail:+ ${G_SEP} }${idparts[ii]}"; done
  (( ${#user} + 1 + ${#host} + 3 + ${#idtail} <= W )) && break
  idn=$(( idn - 1 ))
done
idline="${B}${user}@${host}${R}"
(( idn > 0 )) && idline+="${D} ${G_SEP} ${idtail}${R}"
printf '  %s\n\n' "$idline"

# ── Build panels, most important first ─────────────────────────────
# ATTENTION leads because it is the only one that ever demands action,
# and in a narrow terminal the later panels are the ones scrolled past.
attention=()
[[ -e /var/run/reboot-required || -e /run/reboot-required ]] \
  && attention+=( "${YEL}reboot required${R}${D} ${G_SEP} a package needs it to finish${R}" )
[[ -n "$temp_c" ]] && (( temp_c >= 85 )) \
  && attention+=( "${RED}CPU at ${temp_c}${G_DEG}${R}${D} ${G_SEP} thermal throttling likely${R}" )
[[ -n "$bat_health" ]] && (( bat_health < 65 )) \
  && attention+=( "${YEL}battery at ${bat_health}% of design capacity${R}" )
(( bt_blocked )) && attention+=( "${YEL}bluetooth radio is blocked${R}" )

# STORAGE fills disk_pct, and ATTENTION reads it, so the filesystem scan
# has to happen before either panel is built.
fs_rows=()
if have df; then
  seen_devs=' '
  scan_mount() {
    local dev=$1 mnt=$2
    [[ "$seen_devs" == *" $dev "* ]] && return
    seen_devs+="$dev "
    local _ size used pcent pct
    read -r _ size used _ pcent _ < <(df -P -k "$mnt" 2>/dev/null | tail -n +2)
    [[ -z "${size:-}" || "${pcent:-}" != *% ]] && return
    pct="${pcent%\%}"
    [[ "$pct" == *[!0-9]* ]] && return
    fs_rows+=( "$mnt"$'\x1f'"$pct"$'\x1f'"$(hpair "$used" "$size")" )
    disk_pct+=( "$pct:$mnt" )
  }
  if [[ -r /proc/mounts ]]; then
    while read -r dev mnt fstype _; do
      case "$fstype" in
        ext2|ext3|ext4|xfs|btrfs|f2fs|zfs|vfat|exfat|ntfs|ntfs3) ;;
        *) continue ;;
      esac
      scan_mount "$dev" "$(unescape_mount "$mnt")"
    done < /proc/mounts
  else
    while read -r dev _ _ _ _ mnt; do
      [[ "$dev" == /dev/* ]] || continue
      scan_mount "$dev" "$mnt"
    done < <(df -P -k 2>/dev/null | tail -n +2)
  fi
fi
for entry in "${disk_pct[@]}"; do
  p="${entry%%:*}"; mnt="${entry#*:}"
  (( p >= 90 )) && attention+=( "${RED}${mnt} is ${p}% full${R}" )
done

if (( ${#attention[@]} )); then
  _pw=$FULLW; panel_begin "ATTENTION" 1
  for a in "${attention[@]}"; do panel_text "${YEL}${G_UP}${R} $a"; done
  panel_end
fi

_pw=$BOXW
panel_begin "SYSTEM"
panel_row "OS"       "${os_name:-$OS}"
panel_row "Kernel"   "$kernel"
[[ -n "$uptime_s" ]] && panel_row "Uptime" "$(hsecs "$uptime_s")"
# The shell the USER runs — NOT the one interpreting this script.
# $BASH_VERSION is always set here, because my-computer has a bash
# shebang, so trusting it reported "bash 5.3.9" to someone whose shell
# is zsh. It describes this file's interpreter and nothing else.
#
# The parent process is the shell that actually invoked this, which
# beats $SHELL when someone is running something other than their login
# shell. $SHELL is the fallback.
shell_name=''
if [[ -r "/proc/$PPID/comm" ]]; then
  parent_cmd="$(slurp "/proc/$PPID/comm")"
  case "$parent_cmd" in
    zsh|bash|fish|ksh|mksh|dash|sh|tcsh|csh|elvish|nu) shell_name="$parent_cmd" ;;
  esac
fi
[[ -z "$shell_name" ]] && shell_name="${SHELL##*/}"
shell_ver=''
if [[ -n "$shell_name" ]] && have "$shell_name"; then
  # Ask that shell for its own version — one exec, only on this line.
  case "$shell_name" in
    zsh)  shell_ver="$(cmd1 "$shell_name" -c 'print -rn -- $ZSH_VERSION')" ;;
    bash) shell_ver="$(cmd1 "$shell_name" -c 'printf %s "${BASH_VERSION%%(*}"')" ;;
    fish) shell_ver="$(cmd1 "$shell_name" --version)"; shell_ver="${shell_ver##* }" ;;
  esac
fi
panel_row "Shell" "${shell_name:-—}${shell_ver:+ $shell_ver}"
desktop="${XDG_CURRENT_DESKTOP:-}"; desktop="${desktop#*:}"
[[ "$OS" == Darwin && -z "$desktop" ]] && desktop="Aqua"
[[ -n "${XDG_SESSION_TYPE:-}" ]] && desktop="${desktop:+$desktop ${G_SEP} }${XDG_SESSION_TYPE}"
[[ -n "$desktop" ]] && panel_row "Desktop" "$desktop"
panel_row "Terminal" "${TERM_PROGRAM:-${TERM:-}}"
[[ -n "$pkgs" ]] && panel_row "Packages" "$pkgs"
(( show_all )) && panel_row "Locale" "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
panel_end

panel_begin "HARDWARE"
for junk in '(R)' '(TM)' '(tm)' ' CPU' ' Processor'; do cpu_model="${cpu_model//$junk/}"; done
# The base clock baked into the model string is dropped: the live
# average is measured below, and printing both invites the reader to
# wonder which is real.
cpu_model="${cpu_model%% @ *}"; cpu_model="${cpu_model//  / }"; cpu_model="${cpu_model# }"
(( cores == 0 )) && cores=$threads
[[ -n "$machine" ]] && panel_row "Machine" "$machine${chassis:+ ${G_SEP} $chassis}"
panel_row "CPU" "$cpu_model"
(( threads )) && panel_row "Cores" "${cores}C ${G_SEP} ${threads}T"
if (( clock_mhz || clock_max_mhz )); then
  # Current against maximum: a machine pinned far below its ceiling is
  # throttled or on a power-saving governor, which is why both appear.
  clk=''
  (( clock_mhz )) && clk="$(( clock_mhz / 1000 )).$(( (clock_mhz % 1000) / 100 ))"
  (( clock_max_mhz )) && clk+="${clk:+ / }$(( clock_max_mhz / 1000 )).$(( (clock_max_mhz % 1000) / 100 ))"
  panel_row "Clock" "$clk GHz"
fi
if [[ "$OS" == Linux ]]; then
  pci_ids=''
  for p in /usr/share/hwdata/pci.ids /usr/share/misc/pci.ids; do
    [[ -r "$p" ]] && { pci_ids="$p"; break; }
  done
  lookup_pci() {
    local pair=$1 vid did
    vid="${pair%%:*}"; did="${pair##*:}"
    [[ -n "$pci_ids" ]] && have awk || return
    awk -v v="$(printf '%s' "$vid" | tr 'A-Z' 'a-z')" \
        -v d="$(printf '%s' "$did" | tr 'A-Z' 'a-z')" '
      /^#/        { next }
      /^[0-9a-f]/ { invendor = (tolower($1) == v); next }
      invendor && /^\t[0-9a-f]/ {
        line = $0; sub(/^\t/, "", line)
        if (tolower(substr(line, 1, 4)) == d) { sub(/^[0-9a-f]+[ \t]+/, "", line); print line; exit }
      }' "$pci_ids" 2>/dev/null
  }
  gpus=''
  for card in /sys/class/drm/card[0-9]*; do
    [[ -r "$card/device/uevent" ]] || continue
    pci_id=''
    while IFS='=' read -r k v; do [[ "$k" == PCI_ID ]] && pci_id="$v"; done < "$card/device/uevent"
    [[ -n "$pci_id" ]] || continue
    nm="$(lookup_pci "$pci_id")"
    # Marketing names are bracketed: "Kaby Lake-R GT2 [UHD Graphics 620]"
    # reads better as just the bracketed part.
    [[ "$nm" == *'['*']'* ]] && { nm="${nm##*[}"; nm="${nm%]}"; }
    nm="${nm:-PCI $pci_id}"
    [[ "$gpus" == *"$nm"* ]] || { [[ -n "$gpus" ]] && gpus+=", "; gpus+="$nm"; }
  done
  [[ -n "$gpus" ]] && panel_row "GPU" "$gpus"
  modes=()
  for st in /sys/class/drm/*/status; do
    [[ "$(slurp "$st")" == connected ]] || continue
    m="$(slurp "${st%/status}/modes")"; [[ -n "$m" ]] && modes+=( "$m" )
  done
  if (( ${#modes[@]} )); then
    disp="${modes[0]}"
    (( ${#modes[@]} > 1 )) && disp+=" ${G_SEP} ${#modes[@]} out"
    panel_row "Display" "$disp"
  fi
fi
[[ -n "$bios" ]] && panel_row "BIOS" "$bios"
panel_end

panel_begin "MEMORY"
if (( mem_total > 0 )); then
  panel_meter "RAM" $(( mem_used * 100 / mem_total )) "$(hpair "$mem_used" "$mem_total")"
fi
# Swap appears only when in use: reporting 0% every time trains the eye
# to skip the row, which is exactly when a real 40% would go unnoticed.
if (( swap_total > 0 )); then
  sp=$(( swap_used * 100 / swap_total ))
  (( sp > 0 || show_all )) && panel_meter "Swap" "$sp" "$(hpair "$swap_used" "$swap_total")"
elif (( show_all )); then
  panel_row "Swap" "${D}none${R}"
fi
(( show_all && mem_cached > 0 )) && panel_row "Cached" "$(hkib "$mem_cached")"
panel_end

panel_begin "STORAGE"
if (( ${#fs_rows[@]} )); then
  for row in "${fs_rows[@]}"; do
    mnt="${row%%$'\x1f'*}"; rest="${row#*$'\x1f'}"
    pct="${rest%%$'\x1f'*}"; det="${rest#*$'\x1f'}"
    panel_meter "$(vfit "$mnt" $LW)" "$pct" "$det"
  done
else
  panel_row "Disks" ""
fi
if (( ${#disks[@]} )); then
  panel_rule
  for row in "${disks[@]}"; do
    nm="${row%%$'\x1f'*}"; rest="${row#*$'\x1f'}"
    mdl="${rest%%$'\x1f'*}"; kib="${rest#*$'\x1f'}"
    panel_row "$nm" "$(hkib "$kib") ${D}${G_SEP} ${mdl}${R}"
  done
fi
panel_end

panel_begin "NETWORK"
if [[ -n "$default_iface" ]]; then
  panel_row "Interface" "${GRN}${G_DOT}${R} $default_iface"
  [[ -n "$primary_ip" ]] && panel_row "IPv4" "$primary_ip"
  [[ -n "$gateway"    ]] && panel_row "Gateway" "$gateway"
  [[ -n "$dns_txt"    ]] && panel_row "DNS" "$dns_txt"
else
  panel_row "Interface" "${D}offline${R}"
fi
if [[ -n "$wifi_if" ]]; then
  panel_rule
  [[ -n "$wifi_ssid" ]] && panel_row "Wi-Fi" "$wifi_ssid"
  if [[ -n "$wifi_qual" ]]; then
    # Signal is reported as "quality good/bad", so the meter is inverted
    # relative to the usage bars: more is better here.
    wq=$wifi_qual; (( wq > 100 )) && wq=100
    if   (( wq >= 60 )); then wcol=$GRN
    elif (( wq >= 35 )); then wcol=$YEL
    else                      wcol=$RED
    fi
    panel_row "Signal" "${wcol}${wq}%${R}${wifi_dbm:+ ${D}${G_SEP} ${wifi_dbm} dBm${R}}"
  fi
fi
if (( bt_present )); then
  if (( bt_blocked )); then
    panel_row "Bluetooth" "${YEL}blocked${R}"
  elif (( bt_conns )); then
    panel_row "Bluetooth" "${GRN}${G_DOT}${R} ${bt_conns} connected"
  else
    panel_row "Bluetooth" "${D}on, idle${R}"
  fi
fi
if (( ${#nets[@]} > 1 )); then
  virt=0; extra=''
  for nm in "${nets[@]}"; do
    [[ "$nm" == "$default_iface" ]] && continue
    case "$nm" in
      veth*|docker*|br-*|virbr*|vmnet*|tun*|tap*|cni*|flannel*)
        virt=$(( virt + 1 )); (( show_all )) || continue ;;
    esac
    extra+="${extra:+, }$nm"
  done
  [[ -n "$extra" ]] && panel_row "Also up" "$extra"
  (( virt && ! show_all )) && panel_row "Virtual" "${D}${virt} docker/bridge${R}"
fi
panel_end

# DEVICES only exists when something is actually attached — an empty
# "nothing plugged in" panel would occupy a grid cell to say nothing.
if (( ${#removables[@]} || ${#usb_names[@]} )); then
  panel_begin "DEVICES"
  for row in "${removables[@]}"; do
    nm="${row%%$'\x1f'*}"; rest="${row#*$'\x1f'}"
    mdl="${rest%%$'\x1f'*}"; kib="${rest#*$'\x1f'}"
    mounted=''
    if [[ -r /proc/mounts ]]; then
      while read -r dev mnt _; do
        [[ "$dev" == /dev/"$nm"* ]] && { mounted="$(unescape_mount "$mnt")"; break; }
      done < /proc/mounts
    fi
    panel_row "$nm" "${GRN}${G_DOT}${R} $(hkib "$kib") ${D}${G_SEP} ${mdl}${R}"
    [[ -n "$mounted" ]] && panel_row "" "${D}at ${mounted}${R}" \
                        || panel_row "" "${D}not mounted${R}"
  done
  if (( ${#usb_names[@]} )); then
    (( ${#removables[@]} )) && panel_rule
    if (( show_all )); then
      for nm in "${usb_names[@]}"; do panel_row "USB" "$nm"; done
    else
      panel_row "USB" "${usb_names[0]}"
      (( ${#usb_names[@]} > 1 )) && panel_row "" "${D}+$(( ${#usb_names[@]} - 1 )) more ${G_SEP} --all${R}"
    fi
  fi
  panel_end
fi

# STATUS spans the full width: it is a single line of live numbers, and
# boxing it into one grid cell would waste the rest of the row.
_pw=$FULLW
panel_begin "STATUS" 1
# Built as discrete segments so they can be PACKED across as many lines
# as it takes. Truncating here silently deleted the battery reading —
# and a status line that drops the status is worse than a taller panel.
statseg=()
[[ -n "$load_txt"   ]] && statseg+=( "${D}load${R} $load_txt" )
[[ -n "$proc_count" ]] && statseg+=( "${D}procs${R} $proc_count" )
if [[ -n "$temp_c" ]]; then
  if   (( temp_c >= 85 )); then tcol=$RED
  elif (( temp_c >= 70 )); then tcol=$YEL
  else                          tcol=$GRN
  fi
  statseg+=( "${D}temp${R} ${tcol}${temp_c}${G_DEG}${R}" )
fi
if [[ -n "$bat_pct" ]]; then
  # sev() reads "higher is worse", so it is fed the DEPLETION, not the
  # charge: a full battery must not come out red.
  seg="${D}battery${R} $(sev $(( 100 - bat_pct )))${bat_pct}%${R}"
  [[ -n "$bat_state"  ]] && seg+=" ${D}${bat_state}${R}"
  [[ -n "$bat_health" ]] && seg+=" ${D}health ${bat_health}%${R}"
  statseg+=( "$seg" )
fi
if (( ${#statseg[@]} == 0 )); then
  panel_text "${D}no live metrics available${R}"
else
  avail=$(( FULLW - 6 ))
  cur=''
  for seg in "${statseg[@]}"; do
    if [[ -z "$cur" ]]; then
      cur="$seg"
    elif (( $(vlen "$cur") + 3 + $(vlen "$seg") <= avail )); then
      cur+="   $seg"
    else
      panel_text "$cur"; cur="$seg"
    fi
  done
  [[ -n "$cur" ]] && panel_text "$cur"
fi
panel_end

# ── Lay the panels out ─────────────────────────────────────────────
# Panels are printed a row at a time, taking line N from each panel in
# the row. Short panels are padded so the ones beside them keep their
# left edge.
emit_row() {
  local -a idx=( "$@" )
  local -a flat=() heights=() offs=()
  local b h line acc=0 maxh=0 i r c out
  for b in "${idx[@]}"; do
    h=0
    while IFS= read -r line; do flat+=( "$line" ); h=$(( h + 1 )); done <<< "${PANELS[$b]}"
    heights+=( "$h" ); offs+=( "$acc" ); acc=$(( acc + h ))
    (( h > maxh )) && maxh=$h
  done
  for (( r = 0; r < maxh; r++ )); do
    out='  '
    for (( c = 0; c < ${#idx[@]}; c++ )); do
      if (( r < heights[c] )); then out+="${flat[ offs[c] + r ]}"
      else                          out+="$(rep ' ' $BOXW)"
      fi
      (( c < ${#idx[@]} - 1 )) && out+="$(rep ' ' $GAP)"
    done
    printf '%s\n' "$(rtrim "$out")"
  done
}

row=()
for i in "${!PANELS[@]}"; do
  if (( PANEL_FULL[i] )); then
    (( ${#row[@]} )) && { emit_row "${row[@]}"; row=(); printf '\n'; }
    emit_row "$i"; printf '\n'
    continue
  fi
  row+=( "$i" )
  if (( ${#row[@]} == NCOL )); then
    emit_row "${row[@]}"; row=(); printf '\n'
  fi
done
# An `if`, not `(( … )) && …`: when the grid happens to end on a full
# row there is no trailing partial row, the test is false, and that
# false becomes the script's exit status — reporting failure after a
# perfectly good report. The same trap that puts a phantom "✘ 1" on the
# first prompt when .zshrc ends with a failed test.
if (( ${#row[@]} )); then
  emit_row "${row[@]}"
fi
exit 0
